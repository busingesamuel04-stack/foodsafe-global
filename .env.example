# ==============================================================================
# Food Safety Platform - Environment Variables Template
# ==============================================================================

# PUBLIC CLIENT VARIABLES (Safe for browser / Cloudflare Pages frontend)
# These are exposed to the client bundle via NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
NEXT_PUBLIC_APP_NAME="Food Safety Platform"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==============================================================================
# SERVER-SIDE ONLY SECRETS (Cloudflare Pages Functions / Workers)
# CRITICAL SECURITY RULE:
# NEVER prefix with NEXT_PUBLIC_
# NEVER import or reference in React client components or static pages.
# Use only in /functions/api/* or Cloudflare Workers environment variables.
# ==============================================================================
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key-here
